{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gurgur:network-trace:1",
  "title": "Gurgur network trace",
  "description": "A joined, tick-correlated server authority, outbound replication, client prediction, and presentation recording.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "generatedAt",
    "capture",
    "session",
    "coordinateSystem",
    "server",
    "client",
    "analysis"
  ],
  "properties": {
    "format": { "const": "gurgur-network-trace" },
    "formatVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "capture": { "$ref": "#/$defs/capture" },
    "session": { "$ref": "#/$defs/session" },
    "coordinateSystem": { "$ref": "#/$defs/coordinateSystem" },
    "server": { "$ref": "#/$defs/server" },
    "client": { "$ref": "#/$defs/client" },
    "analysis": { "$ref": "#/$defs/analysis" }
  },
  "$defs": {
    "finiteNumber": { "type": "number" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "runtimeId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "generation"],
      "properties": {
        "index": { "$ref": "#/$defs/nonNegativeInteger" },
        "generation": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" },
        "z": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "quat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" },
        "z": { "$ref": "#/$defs/finiteNumber" },
        "w": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "bodyFields": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/runtimeId" },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/quat" },
        "linearVelocity": { "$ref": "#/$defs/vec3" },
        "angularVelocity": { "$ref": "#/$defs/vec3" },
        "flags": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "bodySnapshot": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/bodyFields" },
        {
          "type": "object",
          "required": ["id", "position", "rotation"]
        }
      ],
      "unevaluatedProperties": false
    },
    "bodyState": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/bodyFields" },
        {
          "type": "object",
          "required": ["id", "position", "rotation", "linearVelocity", "angularVelocity", "awake"],
          "properties": { "awake": { "type": "boolean" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "playerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "yaw",
        "verticalVelocity",
        "grounded",
        "lastProcessedInputSequence",
        "lastJumpCounter",
        "stepCooldown",
        "crouched"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/runtimeId" },
        "position": { "$ref": "#/$defs/vec3" },
        "yaw": { "$ref": "#/$defs/finiteNumber" },
        "verticalVelocity": { "$ref": "#/$defs/finiteNumber" },
        "grounded": { "type": "boolean" },
        "lastProcessedInputSequence": { "type": "integer", "minimum": -1 },
        "lastJumpCounter": { "$ref": "#/$defs/nonNegativeInteger" },
        "stepCooldown": { "$ref": "#/$defs/finiteNumber" },
        "crouched": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldEpoch", "serverTick", "bodies", "players"],
      "properties": {
        "worldEpoch": { "$ref": "#/$defs/nonNegativeInteger" },
        "serverTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "bodies": {
          "type": "array",
          "items": { "$ref": "#/$defs/bodySnapshot" }
        },
        "players": {
          "type": "array",
          "items": { "$ref": "#/$defs/playerSnapshot" }
        }
      }
    },
    "inputCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocolVersion",
        "worldEpoch",
        "sequence",
        "clientTick",
        "moveX",
        "moveZ",
        "lookYaw",
        "lookPitch",
        "buttons",
        "jumpCounter",
        "interactCounter",
        "interactTarget",
        "primaryCounter"
      ],
      "properties": {
        "type": { "const": "input" },
        "protocolVersion": { "const": 1 },
        "worldEpoch": { "$ref": "#/$defs/nonNegativeInteger" },
        "sequence": { "$ref": "#/$defs/nonNegativeInteger" },
        "clientTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "moveX": { "$ref": "#/$defs/finiteNumber" },
        "moveZ": { "$ref": "#/$defs/finiteNumber" },
        "lookYaw": { "$ref": "#/$defs/finiteNumber" },
        "lookPitch": { "$ref": "#/$defs/finiteNumber" },
        "buttons": { "$ref": "#/$defs/nonNegativeInteger" },
        "jumpCounter": { "$ref": "#/$defs/nonNegativeInteger" },
        "interactCounter": { "$ref": "#/$defs/nonNegativeInteger" },
        "interactTarget": {
          "oneOf": [{ "$ref": "#/$defs/runtimeId" }, { "type": "null" }]
        },
        "primaryCounter": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "controllerFields": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "yaw": { "$ref": "#/$defs/finiteNumber" },
        "verticalVelocity": { "$ref": "#/$defs/finiteNumber" },
        "grounded": { "type": "boolean" },
        "lastJumpCounter": { "$ref": "#/$defs/nonNegativeInteger" },
        "stepCooldown": { "$ref": "#/$defs/finiteNumber" },
        "crouched": { "type": "boolean" }
      }
    },
    "controllerState": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/controllerFields" },
        {
          "type": "object",
          "required": [
            "position",
            "yaw",
            "verticalVelocity",
            "grounded",
            "lastJumpCounter",
            "stepCooldown",
            "crouched"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "nullableControllerState": {
      "oneOf": [{ "$ref": "#/$defs/controllerState" }, { "type": "null" }]
    },
    "serverPlayer": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/controllerFields" },
        {
          "type": "object",
          "required": [
            "id",
            "position",
            "yaw",
            "verticalVelocity",
            "grounded",
            "lastProcessedInputSequence",
            "lastJumpCounter",
            "stepCooldown",
            "crouched",
            "grabTarget"
          ],
          "properties": {
            "id": { "$ref": "#/$defs/runtimeId" },
            "lastProcessedInputSequence": { "type": "integer", "minimum": -1 },
            "grabTarget": {
              "oneOf": [{ "$ref": "#/$defs/runtimeId" }, { "type": "null" }]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "serverFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldEpoch", "serverTick", "serverAtMs", "bodies", "players"],
      "properties": {
        "worldEpoch": { "$ref": "#/$defs/nonNegativeInteger" },
        "serverTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "serverAtMs": { "$ref": "#/$defs/finiteNumber" },
        "bodies": {
          "type": "array",
          "items": { "$ref": "#/$defs/bodyState" }
        },
        "players": {
          "type": "array",
          "items": { "$ref": "#/$defs/serverPlayer" }
        }
      }
    },
    "serverInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverTickAtReceipt",
        "serverAtMs",
        "transport",
        "command",
        "accepted",
        "firstReceipt"
      ],
      "properties": {
        "serverTickAtReceipt": { "$ref": "#/$defs/nonNegativeInteger" },
        "serverAtMs": { "$ref": "#/$defs/finiteNumber" },
        "transport": { "enum": ["websocket", "webrtc"] },
        "command": { "$ref": "#/$defs/inputCommand" },
        "accepted": { "type": "boolean" },
        "firstReceipt": { "type": "boolean" }
      }
    },
    "outboundSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverTick",
        "serverAtMs",
        "status",
        "bufferedAmount",
        "packetBytes",
        "selected",
        "wire"
      ],
      "properties": {
        "serverTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "serverAtMs": { "$ref": "#/$defs/finiteNumber" },
        "status": {
          "enum": ["sent", "dropped-backpressure", "transport-unavailable", "send-failed"]
        },
        "bufferedAmount": { "$ref": "#/$defs/nonNegativeInteger" },
        "packetBytes": {
          "oneOf": [{ "$ref": "#/$defs/nonNegativeInteger" }, { "type": "null" }]
        },
        "selected": {
          "oneOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "null" }]
        },
        "wire": {
          "oneOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "null" }]
        }
      }
    },
    "predictionProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "authorityTick",
        "position",
        "rotation",
        "linearVelocity",
        "angularVelocity",
        "extrapolationTicksRemaining",
        "freshnessTicksRemaining",
        "collisionEnabled",
        "holdWhenStale",
        "contactPresentation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/runtimeId" },
        "authorityTick": { "type": "integer", "minimum": -1 },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/quat" },
        "linearVelocity": { "$ref": "#/$defs/vec3" },
        "angularVelocity": { "$ref": "#/$defs/vec3" },
        "extrapolationTicksRemaining": { "$ref": "#/$defs/nonNegativeInteger" },
        "freshnessTicksRemaining": { "$ref": "#/$defs/nonNegativeInteger" },
        "collisionEnabled": { "type": "boolean" },
        "holdWhenStale": { "type": "boolean" },
        "contactPresentation": { "type": "boolean" }
      }
    },
    "predictionInputEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workerAtMs",
        "workerTimeOriginUnixMs",
        "sequence",
        "clientTick",
        "outcome",
        "before",
        "after",
        "pendingInputCount",
        "visibleCorrectionMetres"
      ],
      "properties": {
        "kind": { "const": "input" },
        "workerAtMs": { "$ref": "#/$defs/finiteNumber" },
        "workerTimeOriginUnixMs": { "$ref": "#/$defs/finiteNumber" },
        "sequence": { "$ref": "#/$defs/nonNegativeInteger" },
        "clientTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "outcome": {
          "enum": [
            "predicted",
            "intent-only",
            "queued-without-world",
            "rejected-epoch",
            "implausible-reset"
          ]
        },
        "before": { "$ref": "#/$defs/nullableControllerState" },
        "after": { "$ref": "#/$defs/nullableControllerState" },
        "pendingInputCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "visibleCorrectionMetres": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "reconciliationOutcome": {
      "enum": [
        "replayed",
        "stalled-reset",
        "teleport-reset",
        "implausible-reset",
        "proxy-only",
        "stale-snapshot",
        "missing-player",
        "pending-world",
        "wrong-epoch"
      ]
    },
    "predictionReconciliationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "workerAtMs",
        "workerTimeOriginUnixMs",
        "serverTick",
        "reconcilePlayer",
        "outcome",
        "authority",
        "before",
        "after",
        "acknowledgedInputSequence",
        "pendingInputCountBefore",
        "pendingInputCountAfter",
        "replayedInputSequences",
        "rawErrorMetres",
        "visibleCorrectionMetres",
        "proxies"
      ],
      "properties": {
        "kind": { "const": "reconciliation" },
        "workerAtMs": { "$ref": "#/$defs/finiteNumber" },
        "workerTimeOriginUnixMs": { "$ref": "#/$defs/finiteNumber" },
        "serverTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "reconcilePlayer": { "type": "boolean" },
        "outcome": { "$ref": "#/$defs/reconciliationOutcome" },
        "authority": {
          "oneOf": [{ "$ref": "#/$defs/playerSnapshot" }, { "type": "null" }]
        },
        "before": { "$ref": "#/$defs/nullableControllerState" },
        "after": { "$ref": "#/$defs/nullableControllerState" },
        "acknowledgedInputSequence": {
          "oneOf": [{ "type": "integer", "minimum": -1 }, { "type": "null" }]
        },
        "pendingInputCountBefore": { "$ref": "#/$defs/nonNegativeInteger" },
        "pendingInputCountAfter": { "$ref": "#/$defs/nonNegativeInteger" },
        "replayedInputSequences": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonNegativeInteger" }
        },
        "rawErrorMetres": {
          "oneOf": [{ "$ref": "#/$defs/finiteNumber" }, { "type": "null" }]
        },
        "visibleCorrectionMetres": { "$ref": "#/$defs/finiteNumber" },
        "proxies": {
          "type": "array",
          "items": { "$ref": "#/$defs/predictionProxy" }
        }
      }
    },
    "clientInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientAtMs", "command"],
      "properties": {
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "command": { "$ref": "#/$defs/inputCommand" }
      }
    },
    "clientSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientReceivedAtMs",
        "clientProcessedAtMs",
        "latestInFrame",
        "estimatedServerTickAtReceipt",
        "snapshot"
      ],
      "properties": {
        "clientReceivedAtMs": { "$ref": "#/$defs/finiteNumber" },
        "clientProcessedAtMs": {
          "oneOf": [{ "$ref": "#/$defs/finiteNumber" }, { "type": "null" }]
        },
        "latestInFrame": {
          "oneOf": [{ "type": "boolean" }, { "type": "null" }]
        },
        "estimatedServerTickAtReceipt": { "$ref": "#/$defs/finiteNumber" },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      }
    },
    "clientPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientAtMs", "event"],
      "properties": {
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "event": {
          "oneOf": [
            { "$ref": "#/$defs/predictionInputEvent" },
            { "$ref": "#/$defs/predictionReconciliationEvent" }
          ]
        }
      }
    },
    "presentedBodySource": {
      "enum": [
        "interpolated",
        "current-contact",
        "predicted-proxy",
        "predicted-local",
        "current-local-fallback"
      ]
    },
    "presentedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "source", "comparisonServerTick"],
      "properties": {
        "body": { "$ref": "#/$defs/bodySnapshot" },
        "source": { "$ref": "#/$defs/presentedBodySource" },
        "comparisonServerTick": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "presentationFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientAtMs",
        "latestSnapshotTick",
        "estimatedServerTick",
        "interpolationDelayTicks",
        "presentationTargetTick",
        "extrapolatedBodyIds",
        "bodies"
      ],
      "properties": {
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "latestSnapshotTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "estimatedServerTick": { "$ref": "#/$defs/finiteNumber" },
        "interpolationDelayTicks": { "$ref": "#/$defs/finiteNumber" },
        "presentationTargetTick": { "$ref": "#/$defs/finiteNumber" },
        "extrapolatedBodyIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeId" }
        },
        "bodies": {
          "type": "array",
          "items": { "$ref": "#/$defs/presentedBody" }
        }
      }
    },
    "clockSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientAtMs", "source", "serverTick", "oneWayDelayMs"],
      "properties": {
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "source": { "enum": ["snapshot", "pong"] },
        "serverTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "oneWayDelayMs": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "networkSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientAtMs", "rttMs", "jitterMs"],
      "properties": {
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "rttMs": { "$ref": "#/$defs/finiteNumber" },
        "jitterMs": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "clientMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientAtMs", "kind", "value"],
      "properties": {
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "kind": {
          "enum": ["connection", "transport", "world", "lifecycle", "visibility"]
        },
        "value": { "type": "string" },
        "serverTick": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "formatVersion",
        "captureId",
        "clientStartedAt",
        "clientEndedAt",
        "clientTimeOriginUnixMs",
        "pageUrl",
        "userAgent",
        "inputs",
        "snapshots",
        "prediction",
        "presentation",
        "clocks",
        "network",
        "markers",
        "truncatedStreams"
      ],
      "properties": {
        "format": { "const": "gurgur-network-trace" },
        "formatVersion": { "const": 1 },
        "captureId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "clientStartedAt": { "type": "string", "format": "date-time" },
        "clientEndedAt": { "type": "string", "format": "date-time" },
        "clientTimeOriginUnixMs": { "$ref": "#/$defs/finiteNumber" },
        "pageUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "userAgent": { "type": "string", "maxLength": 1024 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/clientInput" }
        },
        "snapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/clientSnapshot" }
        },
        "prediction": {
          "type": "array",
          "items": { "$ref": "#/$defs/clientPrediction" }
        },
        "presentation": {
          "type": "array",
          "items": { "$ref": "#/$defs/presentationFrame" }
        },
        "clocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/clockSample" }
        },
        "network": {
          "type": "array",
          "items": { "$ref": "#/$defs/networkSample" }
        },
        "markers": {
          "type": "array",
          "items": { "$ref": "#/$defs/clientMarker" }
        },
        "truncatedStreams": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "serverStartedAt", "serverEndedAt", "stopReason", "limits"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "serverStartedAt": { "type": "string", "format": "date-time" },
        "serverEndedAt": { "type": "string", "format": "date-time" },
        "stopReason": {
          "enum": ["user", "duration-limit", "record-limit", "world-changed"]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxDurationMs",
            "maxClientRecords",
            "maxServerFrames",
            "maxServerBodyRecords"
          ],
          "properties": {
            "maxDurationMs": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxClientRecords": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxServerFrames": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxServerBodyRecords": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildRevision",
        "mapRevision",
        "worldEpoch",
        "playerId",
        "physicsHz",
        "snapshotHz"
      ],
      "properties": {
        "buildRevision": { "type": "string" },
        "mapRevision": { "type": "string" },
        "worldEpoch": { "$ref": "#/$defs/nonNegativeInteger" },
        "playerId": { "$ref": "#/$defs/runtimeId" },
        "physicsHz": { "$ref": "#/$defs/finiteNumber" },
        "snapshotHz": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linearUnits",
        "angularUnits",
        "handedness",
        "upAxis",
        "forwardAtZeroYaw",
        "timestamps"
      ],
      "properties": {
        "linearUnits": { "const": "metres" },
        "angularUnits": { "const": "radians" },
        "handedness": { "const": "right" },
        "upAxis": { "const": "+Y" },
        "forwardAtZeroYaw": { "const": "-Z" },
        "timestamps": { "const": "milliseconds" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startTick",
        "endTick",
        "frames",
        "inputs",
        "outboundSnapshots",
        "truncatedStreams"
      ],
      "properties": {
        "startTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "endTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "frames": {
          "type": "array",
          "items": { "$ref": "#/$defs/serverFrame" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/serverInput" }
        },
        "outboundSnapshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/outboundSnapshot" }
        },
        "truncatedStreams": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "p50", "p95", "p99", "max"],
      "properties": {
        "samples": { "$ref": "#/$defs/nonNegativeInteger" },
        "p50": { "$ref": "#/$defs/nullableMetricNumber" },
        "p95": { "$ref": "#/$defs/nullableMetricNumber" },
        "p99": { "$ref": "#/$defs/nullableMetricNumber" },
        "max": { "$ref": "#/$defs/nullableMetricNumber" }
      }
    },
    "nullableMetricNumber": {
      "oneOf": [{ "$ref": "#/$defs/finiteNumber" }, { "type": "null" }]
    },
    "poseErrorFields": {
      "type": "object",
      "properties": {
        "positionMetres": { "$ref": "#/$defs/metric" },
        "rotationDegrees": { "$ref": "#/$defs/metric" }
      }
    },
    "poseError": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/poseErrorFields" },
        {
          "type": "object",
          "required": ["positionMetres", "rotationDegrees"]
        }
      ],
      "unevaluatedProperties": false
    },
    "stateErrorFields": {
      "type": "object",
      "properties": {
        "linearVelocityMetresPerSecond": { "$ref": "#/$defs/metric" },
        "angularVelocityRadiansPerSecond": { "$ref": "#/$defs/metric" }
      }
    },
    "wireAnalysis": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/poseErrorFields" },
        { "$ref": "#/$defs/stateErrorFields" },
        {
          "type": "object",
          "required": [
            "positionMetres",
            "rotationDegrees",
            "linearVelocityMetresPerSecond",
            "angularVelocityRadiansPerSecond",
            "selectedRecords",
            "wireRecords",
            "missingWireRecords"
          ],
          "properties": {
            "selectedRecords": { "$ref": "#/$defs/nonNegativeInteger" },
            "wireRecords": { "$ref": "#/$defs/nonNegativeInteger" },
            "missingWireRecords": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "deliveryAnalysis": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/poseErrorFields" },
        { "$ref": "#/$defs/stateErrorFields" },
        {
          "type": "object",
          "required": [
            "positionMetres",
            "rotationDegrees",
            "linearVelocityMetresPerSecond",
            "angularVelocityRadiansPerSecond",
            "outboundSent",
            "clientReceived",
            "matchedSnapshots",
            "unmatchedClientSnapshots",
            "bodySetMismatches",
            "droppedBackpressure",
            "transportUnavailable",
            "sendFailed"
          ],
          "properties": {
            "outboundSent": { "$ref": "#/$defs/nonNegativeInteger" },
            "clientReceived": { "$ref": "#/$defs/nonNegativeInteger" },
            "matchedSnapshots": { "$ref": "#/$defs/nonNegativeInteger" },
            "unmatchedClientSnapshots": { "$ref": "#/$defs/nonNegativeInteger" },
            "bodySetMismatches": { "$ref": "#/$defs/nonNegativeInteger" },
            "droppedBackpressure": { "$ref": "#/$defs/nonNegativeInteger" },
            "transportUnavailable": { "$ref": "#/$defs/nonNegativeInteger" },
            "sendFailed": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "worstCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverTick",
        "clientAtMs",
        "rawErrorMetres",
        "outcome",
        "acknowledgedInputSequence",
        "replayedInputCount"
      ],
      "properties": {
        "serverTick": { "$ref": "#/$defs/nonNegativeInteger" },
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "rawErrorMetres": { "$ref": "#/$defs/finiteNumber" },
        "outcome": { "$ref": "#/$defs/reconciliationOutcome" },
        "acknowledgedInputSequence": {
          "oneOf": [{ "type": "integer", "minimum": -1 }, { "type": "null" }]
        },
        "replayedInputCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "worstPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverTick",
        "clientAtMs",
        "id",
        "source",
        "positionErrorMetres",
        "rotationErrorDegrees"
      ],
      "properties": {
        "serverTick": { "$ref": "#/$defs/finiteNumber" },
        "clientAtMs": { "$ref": "#/$defs/finiteNumber" },
        "id": { "$ref": "#/$defs/runtimeId" },
        "source": { "$ref": "#/$defs/presentedBodySource" },
        "positionErrorMetres": { "$ref": "#/$defs/finiteNumber" },
        "rotationErrorDegrees": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisVersion",
        "wireQuantization",
        "clientDelivery",
        "prediction",
        "presentation",
        "timing",
        "notes"
      ],
      "properties": {
        "analysisVersion": { "const": 1 },
        "wireQuantization": { "$ref": "#/$defs/wireAnalysis" },
        "clientDelivery": { "$ref": "#/$defs/deliveryAnalysis" },
        "prediction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rawCorrectionMetres",
            "proxyAuthorityAgeTicks",
            "proxyFreshnessTicksRemaining",
            "disabledContactProxySamples",
            "reconciliationOutcomes",
            "worstCorrections"
          ],
          "properties": {
            "rawCorrectionMetres": { "$ref": "#/$defs/metric" },
            "proxyAuthorityAgeTicks": { "$ref": "#/$defs/metric" },
            "proxyFreshnessTicksRemaining": { "$ref": "#/$defs/metric" },
            "disabledContactProxySamples": { "$ref": "#/$defs/nonNegativeInteger" },
            "reconciliationOutcomes": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" }
            },
            "worstCorrections": {
              "type": "array",
              "items": { "$ref": "#/$defs/worstCorrection" }
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bySource", "missingAuthoritySamples", "worst"],
          "properties": {
            "bySource": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "interpolated": { "$ref": "#/$defs/poseError" },
                "current-contact": { "$ref": "#/$defs/poseError" },
                "predicted-proxy": { "$ref": "#/$defs/poseError" },
                "predicted-local": { "$ref": "#/$defs/poseError" },
                "current-local-fallback": { "$ref": "#/$defs/poseError" }
              }
            },
            "missingAuthoritySamples": { "$ref": "#/$defs/nonNegativeInteger" },
            "worst": {
              "type": "array",
              "items": { "$ref": "#/$defs/worstPresentation" }
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputAcknowledgementMs", "snapshotAgeMs", "replayedInputs"],
          "properties": {
            "inputAcknowledgementMs": { "$ref": "#/$defs/metric" },
            "snapshotAgeMs": { "$ref": "#/$defs/metric" },
            "replayedInputs": { "$ref": "#/$defs/metric" }
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
